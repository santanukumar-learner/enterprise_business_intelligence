# Docker stack only. Generate fresh random secrets; do not use these placeholders.
POSTGRES_PASSWORD=replace_with_alphanumeric_random_secret
JWT_SECRET=replace_with_at_least_32_random_characters
# Optional for native Python hosting:
# DATABASE_URL=postgresql+psycopg://user:password@host/db?sslmode=require
# DATABASE_URL_POOLED=postgresql://user:password@pooler-host/db?sslmode=require&channel_binding=require
# REDIS_URL=redis://localhost:6379/0
# APP_ENV=production
